{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Professional DocX",
  "version": "0.1.0",
  "identifier": "com.professionaldocx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Professional DocX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol:",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost pdx-preview: http://pdx-preview.localhost https://pdx-preview.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
